{
  "name": "lexicon-mcp-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && node scripts/check-architecture.mjs && node scripts/check-licenses.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages/server/src packages/server/test",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
