{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "packages/server/dist",
    "rootDir": "packages/server/src",
    "declaration": true
  },
  "include": ["packages/server/src/**/*.ts"]
}
